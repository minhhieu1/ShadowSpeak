# ShadowSpeak backend — LOCAL DEVELOPMENT environment.
# Copy to backend/.env:
#   cp backend/.env.dev.example backend/.env

APP_ENV=dev
APP_NAME=ShadowSpeak API
API_VERSION=v1
LOG_LEVEL=DEBUG

# ── OIDC Authentication (Keycloak for local dev) ──────────────────────────
AUTH_PROVIDER=keycloak
AUTH_ISSUER=http://localhost:8080/realms/shadowspeak
AUTH_JWKS_URL=http://localhost:8080/realms/shadowspeak/protocol/openid-connect/certs
AUTH_AUDIENCE=shadowspeak-api
AUTH_CLIENT_ID=shadowspeak-client
AUTH_REDIRECT_URI=shadowspeak://callback
AUTH_SCOPES=["openid","profile","email"]
AUTH_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/shadowspeak/protocol/openid-connect/auth
AUTH_TOKEN_ENDPOINT=http://localhost:8080/realms/shadowspeak/protocol/openid-connect/token
AUTH_REVOCATION_ENDPOINT=http://localhost:8080/realms/shadowspeak/protocol/openid-connect/revoke
AUTH_END_SESSION_ENDPOINT=http://localhost:8080/realms/shadowspeak/protocol/openid-connect/logout
AUTH_USER_ID_CLAIM=sub
AUTH_ROLES_CLAIM=realm_access.roles

# ── DynamoDB (local) ──────────────────────────────────────────────────────
DYNAMODB_TABLE_NAME=shadowspeak-dev
DYNAMODB_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8010

# ── AWS (dummy credentials for local dev) ─────────────────────────────────
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_DEFAULT_REGION=us-east-1
