{
  "expo": {
    "name": "ShadowSpeak",
    "slug": "shadowspeak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shadowspeak",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shadowspeak.app"
    },
    "android": {
      "package": "com.shadowspeak.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-icon.png",
        "backgroundColor": "#F7F5F0"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-status-bar",
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
