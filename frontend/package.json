{
  "name": "shadowspeak",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf  node_modules .expo package-lock.json",
    "maestro:test": "maestro test .maestro",
    "maestro:smoke": "maestro test .maestro --include-tags=smoke",
    "maestro:all": "maestro test .maestro --include-tags=all",
    "maestro": "maestro test --format junit --output reports/maestro/maestro-report.xml .maestro",
    "stop": "kill $(lsof -ti tcp:8081) 2>/dev/null; kill $(lsof -ti tcp:19000) 2>/dev/null; kill $(lsof -ti tcp:19001) 2>/dev/null; kill $(lsof -ti tcp:19002) 2>/dev/null; pkill -f 'expo' 2>/dev/null; pkill -f 'metro' 2>/dev/null; echo 'Expo processes stopped'"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.17.0",
    "babel-preset-expo": "^56.0.14",
    "expo": "^56.0.9",
    "expo-constants": "~56.0.17",
    "expo-dev-client": "~56.0.19",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.9",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "react-refresh": "^0.18.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "20 || >=22"
  },
  "private": true
}
