{
  "name": "shadowspeak",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rimraf node_modules package-lock.json",
    "maestro:test": "maestro test .maestro",
    "maestro:smoke": "maestro test .maestro --include-tags=smoke",
    "maestro:all": "maestro test .maestro --include-tags=all",
    "maestro": "maestro test --format junit --output reports/maestro/maestro-report.xml .maestro"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "axios": "^1.17.0",
    "expo": "~54.0.33",
    "expo-dev-client": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": "20 || >=22"
  },
  "private": true
}
